    function backToGameSelect() { sfxTap(); renderGameSelect(); }

    function updatePlayHUD() {
      const alive = blocks.filter(b => b.alive).length;
      document.getElementById('play-blocks-left').textContent = playMode === 'revenge' ? `🔥 のこり ${alive}個` : `💎 のこり ${alive}個`;
      const cp = document.getElementById('play-combo-pill');
      cp.textContent = combo >= 5 ? `🌈 ${combo} SUPER!` : (combo >= 3 ? `⚡ ${combo} FEVER!` : `${combo} COMBO`);
      cp.classList.toggle('hot', combo >= 1);
      cp.classList.toggle('fever', combo >= 3);
    }

    function nextQ() {
      if (blocks.filter(b => b.alive).length === 0) { finishStage(); return; }
      if (!playQueue.length) playQueue = shuffle(playPool);
      curQ = playQueue.shift(); locked = false;
      document.getElementById('play-feedback-bar').classList.remove('show');
      document.getElementById('play-q-text').textContent = curQ.q;
      const g = document.getElementById('play-choices-grid'); g.innerHTML = '';
      const lbl = ['A','B','C','D'];
      shuffle(curQ.options).forEach((opt, i) => {
        const b = document.createElement('button'); b.className = 'choice-btn'; b.dataset.val = opt;
        b.innerHTML = `<span class="choice-num">${lbl[i]}</span><span>${opt}</span>`;
        b.onclick = () => onAnswer(opt, b);
        g.appendChild(b);
      });
    }

    function shake(cls) { const el = document.getElementById('stage-box'); el.classList.remove('shake-light','shake-heavy','shake-wrong'); void el.offsetWidth; el.classList.add(cls); }

    function onAnswer(sel, btn) {
      if (locked) return; locked = true; ansCnt++;
      document.querySelectorAll('#play-choices-grid .choice-btn').forEach(b => b.disabled = true);
      if (sel === curQ.a) {
        btn.classList.add('is-correct'); corCnt++; combo++; if (combo > maxCombo) maxCombo = combo;
        sfxCorrect(combo);
        if (playMode === 'revenge') { state.weakness = state.weakness.filter(x => x !== curQ.id); saveState(); }
        const cnt = playMode === 'revenge' ? 1 : (combo >= 5 ? 3 : (combo >= 3 ? 2 : 1));
        const targets = shuffle(blocks.filter(b => b.alive)).slice(0, cnt);
        const fev = cnt >= 2;
        document.getElementById('play-speech').textContent = combo >= 5 ? '🌈スーパーフィーバー！3コ割り！' : (combo >= 3 ? '⚡フィーバー！2コ同時割り！' : 'ナイス！その調子だよ✨');
        updatePlayHUD();
        let done = 0;
        const rect = canvas.parentElement.getBoundingClientRect();
        targets.forEach((tb, idx) => {
          setTimeout(() => {
            projectiles.push({
              sx: -8, sy: (rect.height || 200) * 0.6, tx: tb.x + tb.w/2, ty: tb.y + tb.h/2, t: 0, fev,
              cb: () => {
                shatter(tb, fev); shake(fev ? 'shake-heavy' : 'shake-light');
                if (idx === 0) floatTexts.push({ t: cnt===3?'SUPER!! ×3':(cnt===2?'FEVER!! ×2':'NICE! ✨'), x: tb.x+tb.w/2, y: tb.y, c: fev?'#f59e0b':'#2563eb', sz: fev?21:17, life: 1 });
                done++; updatePlayHUD();
                if (done === targets.length) setTimeout(nextQ, 420);
              }
            });
          }, idx * 75);
        });
      } else {
        btn.classList.add('is-wrong');
        document.querySelectorAll('#play-choices-grid .choice-btn').forEach(b => { if (b.dataset.val === curQ.a) b.classList.add('is-correct'); });
        missCnt++; combo = 0; sfxWrong(); shake('shake-wrong');
        if (!state.weakness.includes(curQ.id)) { state.weakness.push(curQ.id); saveState(); }
        updatePlayHUD();
        document.getElementById('play-speech').textContent = 'おしいっ！ヒントを見て覚えようね。';
        document.getElementById('play-feedback-ans').textContent = `せいかい：${curQ.a}`;
        document.getElementById('play-feedback-hint').textContent = `💡 ${curQ.hint}`;
        document.getElementById('play-feedback-bar').classList.add('show');
        if (playMode === 'revenge') playQueue.push(curQ);
      }
    }
    function proceedAfterWrong() { sfxTap(); nextQ(); }

    function finishStage() {
      sfxFanfare(); launchConfetti(85);
      const acc = ansCnt ? Math.round((corCnt / ansCnt) * 100) : 100;
      const isFirst = playMode === 'unit' && !state.unitStars[String(playUnitId)];
      if (playMode === 'unit') {
        const st = missCnt === 0 ? 3 : (missCnt <= 2 ? 2 : 1);
        if (st > (state.unitStars[String(playUnitId)] || 0)) state.unitStars[String(playUnitId)] = st;
      }
      const miles = (playMode === 'revenge' ? Math.min(50, 15 + corCnt * 3) : 30) + (isFirst ? 15 : 0) + (missCnt === 0 ? 10 : 0) + maxCombo;
      state.miles += miles; saveState();
      const mc = document.getElementById('mile-chip'); mc.classList.add('pop'); setTimeout(() => mc.classList.remove('pop'), 300);

      document.getElementById('play-quiz-box').style.display = 'none';
      document.getElementById('res-acc').textContent = `${acc}%`;
      document.getElementById('res-combo').textContent = `${maxCombo}`;
      document.getElementById('res-miss').textContent = `${missCnt}問`;
      document.getElementById('res-reward').textContent = `✈️ +${miles} 旅マイル ゲット！`;
      const rb = document.getElementById('clear-revenge-btn');
      rb.style.display = state.weakness.length ? 'inline-block' : 'none';
      document.getElementById('play-clear-panel').classList.add('show');
    }

    // ========= 🔥 弱点・📚 要点演習 =========
    function renderWeakTab() {
      const wqs = state.weakness.map(id => DB.gameQuestions.find(q => q.id === id)).filter(Boolean);
      document.getElementById('weak-title').textContent = `🔥 弱点ノート（${wqs.length}問）`;
      const rb = document.getElementById('weak-rev-btn');
      rb.disabled = !wqs.length; rb.style.opacity = wqs.length ? '1' : '0.45';
      const list = document.getElementById('weak-list'); list.innerHTML = '';
      if (!wqs.length) {
        list.innerHTML = '<div class="card" style="text-align:center; padding:32px; color:#059669; font-weight:800;">🎉 いま弱点はありません！ブロック崩しで間違えた問題がここにたまります。</div>';
        return;
      }
      wqs.forEach((q, i) => {
        const d = document.createElement('div'); d.className = 'question-card';
        d.innerHTML = `
          <div class="q-head"><span>🎮 ゲーム4択 弱点</span><span>Q${i+1}</span></div>
          <div class="q-body">${q.q}<div style="margin-top:10px;background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;padding:9px 12px;"><div style="color:#15803d;font-weight:900;">せいかい：${q.a}</div><div style="font-size:0.84rem;margin-top:3px;">💡 ${q.hint}</div></div></div>
          <div style="padding:8px 14px; text-align:right; border-top:1px solid var(--border);"><button class="btn-mint" style="padding:6px 14px; font-size:0.8rem;" onclick="clearWeak('${q.id}')">✓ 覚えた！（弱点から消す）</button></div>
        `;
        list.appendChild(d);
      });
    }
    function clearWeak(id) { sfxFanfare(); state.weakness = state.weakness.filter(x => x !== id); saveState(); renderWeakTab(); showToast('✨ 1問克服したよ！'); }

    function renderStudyTab() {
      const list = document.getElementById('study-questions-list'); list.innerHTML = '';
      DB.questions.forEach((q, i) => {
        const d = document.createElement('div'); d.className = 'question-card';
        const tag = q.section === 'diag' ? '🔍 弱点診断テスト' : '✏️ ポイント・チェック';
        d.innerHTML = `
          <div class="q-head"><span>${tag}</span><span>Q${i+1}</span></div>
          <div class="q-body">${q.q}</div>
          <button class="accordion-toggle" onclick="const c=this.nextElementSibling; c.classList.toggle('open');"><span>👉 模範解答・解説を見る（補完済み）</span><span>▼</span></button>
          <div class="accordion-content"><div style="font-weight:900; font-size:1.02rem; color:#1e3a5f;">${q.a}</div><div class="desc-box">💡 ${q.desc}</div></div>
        `;
        list.appendChild(d);
      });
    }

    // ========= タブ切替・初期化 =========
    function switchTab(t) {
      document.querySelectorAll('.nav-item').forEach(x => x.classList.toggle('active', x.dataset.tab === t));
      document.querySelectorAll('.view-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('view-' + t).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'instant' });
      if (t === 'map') renderJapanMap();
      if (t === 'game') { if (document.getElementById('game-play-view').style.display !== 'none') { syncPlayArenaVisual(); setTimeout(resizeCanvas, 30); } else renderGameSelect(); }
      if (t === 'album') renderAlbum();
      if (t === 'weak') renderWeakTab();
      if (t === 'study') renderStudyTab();
    }

    let toastT = null;
    function showToast(msg) { const e = document.getElementById('toast'); e.textContent = msg; e.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => e.classList.remove('show'), 2200); }

    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      updateHeader();
      buildGameFilters();
      renderJapanMap();
      renderGameSelect();
      renderStudyTab();
      if (!animStarted) { animStarted = true; requestAnimationFrame(loopCanvas); requestAnimationFrame(loopConfetti); }
    });
    window.addEventListener('resize', () => { if (document.getElementById('game-play-view').style.display !== 'none') resizeCanvas(); });
  </script>
</body>
</html>
