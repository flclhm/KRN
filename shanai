    // Canvasエンジン
    const canvas = document.getElementById('block-canvas');
    const ctx2d = canvas.getContext('2d');
    let blocks = [], particles = [], projectiles = [], floatTexts = [], animStarted = false;
    const NORMAL_PAL = [
      { top: '#60a5fa', bot: '#2563eb', rim: '#dbeafe' },
      { top: '#f472b6', bot: '#db2777', rim: '#fce7f3' },
      { top: '#34d399', bot: '#059669', rim: '#d1fae5' },
      { top: '#fbbf24', bot: '#d97706', rim: '#fef3c7' },
      { top: '#a78bfa', bot: '#7c3aed', rim: '#ede9fe' }
    ];
    const REV_PAL = [{ top: '#fb7185', bot: '#e11d48', rim: '#ffe4e6' }, { top: '#fb923c', bot: '#c2410c', rim: '#ffedd5' }];

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(rect.width * dpr); canvas.height = Math.floor(rect.height * dpr);
      ctx2d.setTransform(dpr, 0, 0, dpr, 0, 0);
      layoutBlocks();
    }
    function createBlocks(count, isRev) {
      blocks = [];
      const pal = isRev ? REV_PAL : NORMAL_PAL;
      for (let i = 0; i < count; i++) blocks.push({ alive: true, color: pal[i % pal.length], isRev, x:0, y:0, w:40, h:30 });
      layoutBlocks();
    }
    function layoutBlocks() {
      const rect = canvas.parentElement.getBoundingClientRect();
      const W = rect.width || 280, H = rect.height || 200, n = blocks.length;
      if (!n) return;
      const cols = n <= 4 ? n : (n <= 6 ? 3 : 4), rows = Math.ceil(n / cols);
      const padX = 8, padY = 12, gap = 7;
      const bw = Math.min(92, (W - padX * 2 - gap * (cols - 1)) / cols);
      const bh = Math.min(44, (H - padY * 2 - gap * (rows - 1)) / Math.max(rows, 3));
      const sx = (W - (bw * cols + gap * (cols - 1))) / 2;
      const sy = (H - (bh * rows + gap * (rows - 1))) / 2;
      blocks.forEach((b, i) => { b.x = sx + (i % cols) * (bw + gap); b.y = sy + Math.floor(i / cols) * (bh + gap); b.w = bw; b.h = bh; });
    }
    function drawRR(c, x, y, w, h, r) { c.beginPath(); c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,r); c.arcTo(x,y+h,x,y,r); c.arcTo(x,y,x+w,y,r); c.closePath(); }
    function shatter(b, isFev) {
      b.alive = false;
      const cx = b.x + b.w/2, cy = b.y + b.h/2;
      for (let i = 0; i < (isFev ? 20 : 13); i++) {
        const a = Math.random() * Math.PI * 2, s = 2 + Math.random() * (isFev ? 5.8 : 4);
        particles.push({ x:cx, y:cy, vx:Math.cos(a)*s, vy:Math.sin(a)*s-2.2, size:4+Math.random()*5, rot:Math.random()*3, vrot:(Math.random()-0.5)*0.35, life:1, color:i%3===0?'#fff':b.color.top, shape:i%3===0?'star':'shard' });
      }
    }
    function loopCanvas() {
      if (document.getElementById('game-play-view').style.display !== 'none') {
        const rect = canvas.parentElement.getBoundingClientRect();
        ctx2d.clearRect(0, 0, rect.width || 300, rect.height || 200);
        const now = performance.now() * 0.003;
        blocks.forEach((b, i) => {
          if (!b.alive) return;
          const by = b.y + Math.sin(now + i * 0.6) * 2;
          drawRR(ctx2d, b.x+2, by+4, b.w, b.h, 9); ctx2d.fillStyle = 'rgba(15,25,50,0.22)'; ctx2d.fill();
          const gr = ctx2d.createLinearGradient(b.x, by, b.x, by + b.h);
          gr.addColorStop(0, b.color.top); gr.addColorStop(1, b.color.bot);
          drawRR(ctx2d, b.x, by, b.w, b.h, 9); ctx2d.fillStyle = gr; ctx2d.fill();
          ctx2d.lineWidth = 2; ctx2d.strokeStyle = b.color.rim; ctx2d.stroke();
          drawRR(ctx2d, b.x+5, by+4, b.w-10, b.h*0.34, 4); ctx2d.fillStyle = 'rgba(255,255,255,0.42)'; ctx2d.fill();
          ctx2d.fillStyle = 'rgba(255,255,255,0.85)'; ctx2d.font = 'bold 13px sans-serif'; ctx2d.textAlign = 'center'; ctx2d.textBaseline = 'middle';
          ctx2d.fillText(b.isRev ? '🔥' : '✦', b.x + b.w/2, by + b.h/2 + 1);
        });
        for (let i = projectiles.length - 1; i >= 0; i--) {
          const p = projectiles[i]; p.t += 0.115; const t = Math.min(1, p.t);
          const cx = p.sx + (p.tx - p.sx)*t, cy = p.sy + (p.ty - p.sy)*t - Math.sin(t*Math.PI)*32;
          ctx2d.beginPath(); ctx2d.arc(cx, cy, p.fev ? 10 : 7, 0, Math.PI*2); ctx2d.fillStyle = '#fff'; ctx2d.fill();
          ctx2d.lineWidth = 3.5; ctx2d.strokeStyle = p.fev ? '#fbbf24' : '#38bdf8'; ctx2d.stroke();
          if (p.t >= 1) { p.cb(); projectiles.splice(i, 1); }
        }
        for (let i = particles.length - 1; i >= 0; i--) {
          const pt = particles[i]; pt.x+=pt.vx; pt.y+=pt.vy; pt.vy+=0.22; pt.rot+=pt.vrot; pt.life-=0.028;
          if (pt.life<=0) { particles.splice(i,1); continue; }
          ctx2d.save(); ctx2d.globalAlpha = pt.life; ctx2d.translate(pt.x, pt.y); ctx2d.rotate(pt.rot); ctx2d.fillStyle = pt.color;
          if (pt.shape==='star') { ctx2d.font=`${Math.round(pt.size*2)}px sans-serif`; ctx2d.textAlign='center'; ctx2d.fillText('★',0,0); }
          else { ctx2d.beginPath(); ctx2d.moveTo(-pt.size,-pt.size*0.6); ctx2d.lineTo(pt.size,0); ctx2d.lineTo(-pt.size*0.2,pt.size); ctx2d.closePath(); ctx2d.fill(); }
          ctx2d.restore();
        }
        for (let i = floatTexts.length - 1; i >= 0; i--) {
          const f = floatTexts[i]; f.y -= 1.1; f.life -= 0.024;
          if (f.life<=0) { floatTexts.splice(i,1); continue; }
          ctx2d.save(); ctx2d.globalAlpha = Math.min(1, f.life*1.4); ctx2d.font = `900 ${f.sz}px sans-serif`; ctx2d.textAlign='center';
          ctx2d.lineWidth=4; ctx2d.strokeStyle='#fff'; ctx2d.strokeText(f.t, f.x, f.y); ctx2d.fillStyle=f.c; ctx2d.fillText(f.t, f.x, f.y); ctx2d.restore();
        }
      }
      requestAnimationFrame(loopCanvas);
    }

    let playMode = 'unit', playUnitId = 1, playPool = [], playQueue = [], curQ = null;
    let combo = 0, maxCombo = 0, ansCnt = 0, corCnt = 0, missCnt = 0, locked = false;

    function shuffle(a) { const x=[...a]; for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];} return x; }

    function syncPlayArenaVisual() {
      const p = getPref(state.displayPref);
