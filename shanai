  <script>
    const DB = window.SHAKAI_DB;
    const SAVE_KEY = 'memocheck_shakai_proto_v1';
    const MOVE_COST = 50; // 試作版は50マイルで1県移動（本番80単元時は80マイル想定）

    let state = {
      miles: 180,          // 試作版はお試しですぐ数県動ける初期マイル
      sound: true,
      charName: 'ましろ',
      currentPref: 13,     // 現在地（13: 東京都スタート）
      displayPref: 13,     // ゲーム背景に使うお気に入り旅先
      visited: [13],       // 訪問済み都道府県コード配列
      weakness: [],        // ゲーム弱点ID配列
      unitStars: {}
    };

    let selectedPrefCode = 13;
    let activeGameTheme = 'すべて';

    // ========= 保存・読込 =========
    function loadState() {
      try {
        const raw = localStorage.getItem(SAVE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          state = { ...state, ...p };
          if (!Array.isArray(state.visited) || state.visited.length === 0) state.visited = [13];
          if (!Array.isArray(state.weakness)) state.weakness = [];
        }
      } catch (e) {}
      selectedPrefCode = state.currentPref || 13;
    }
    function saveState() {
      try { localStorage.setItem(SAVE_KEY, JSON.stringify(state)); } catch (e) {}
      updateHeader();
    }

    function getPref(code) { return DB.prefsMaster.find(p => p.code === code) || DB.prefsMaster[12]; }

    function updateHeader() {
      const cur = getPref(state.currentPref);
      const pct = Math.round((state.visited.length / 47) * 100);
      document.getElementById('header-travel-stat').innerHTML =
        `日本一周: <span>${state.visited.length} / 47都道府県</span>（現在地: ${cur.name}）`;
      document.getElementById('travel-progress-bar').style.width = `${pct}%`;
      document.getElementById('mile-val').textContent = state.miles;
      document.getElementById('sound-btn').textContent = state.sound ? '🔊 音ON' : '🔇 音OFF';
      const wb = document.getElementById('nav-weak-count');
      if (state.weakness.length > 0) { wb.style.display = 'inline-flex'; wb.textContent = state.weakness.length; }
      else wb.style.display = 'none';
    }

    // ========= 効果音 =========
    let audioCtx = null;
    function getAudio() {
      if (!state.sound) return null;
      if (!audioCtx) { const C = window.AudioContext || window.webkitAudioContext; if (C) audioCtx = new C(); }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }
    function playTone(freq, type, dur, vol = 0.14, delay = 0, slideTo = null) {
      const ctx = getAudio(); if (!ctx) return;
      const now = ctx.currentTime + delay;
      const osc = ctx.createOscillator(), g = ctx.createGain();
      osc.type = type; osc.frequency.setValueAtTime(freq, now);
      if (slideTo) osc.frequency.exponentialRampToValueAtTime(slideTo, now + dur);
      g.gain.setValueAtTime(0.001, now); g.gain.linearRampToValueAtTime(vol, now + 0.014);
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      osc.connect(g); g.connect(ctx.destination); osc.start(now); osc.stop(now + dur + 0.02);
    }
    function playNoise(dur = 0.14, vol = 0.12, delay = 0) {
      const ctx = getAudio(); if (!ctx) return;
      const now = ctx.currentTime + delay, len = Math.floor(ctx.sampleRate * dur);
      const buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0);
      for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (len * 0.35));
      const src = ctx.createBufferSource(); src.buffer = buf;
      const f = ctx.createBiquadFilter(); f.type = 'highpass'; f.frequency.value = 1200;
      const g = ctx.createGain(); g.gain.setValueAtTime(vol, now); g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      src.connect(f); f.connect(g); g.connect(ctx.destination); src.start(now);
    }
    const SCALE = [523.25, 587.33, 659.25, 698.46, 783.99, 880, 987.77, 1046.5, 1174.66, 1318.5];
    function sfxCorrect(c) {
      const b = SCALE[Math.min(c - 1, SCALE.length - 1)];
      playTone(b, 'triangle', 0.12, 0.16, 0, b * 1.24);
      playNoise(0.15, 0.13, 0.13);
      playTone(b * 1.5, 'sine', 0.18, 0.14, 0.13);
      if (c >= 3) { playTone(b * 1.25, 'sine', 0.22, 0.12, 0.17); playTone(b * 2, 'triangle', 0.25, 0.12, 0.21); }
    }
    function sfxWrong() { playTone(255, 'sawtooth', 0.14, 0.08, 0, 205); playTone(195, 'sawtooth', 0.18, 0.08, 0.13, 160); }
    function sfxFanfare() { [523.25, 659.25, 783.99, 1046.5, 1318.5].forEach((n, i) => playTone(n, 'triangle', 0.24, 0.15, i * 0.085)); }
    function sfxTap() { playTone(620, 'sine', 0.055, 0.06, 0, 760); }
    function toggleSound() { state.sound = !state.sound; saveState(); if (state.sound) sfxTap(); }

    // ========= 紙吹雪 =========
    const confCanvas = document.getElementById('confetti-canvas');
    const confCtx = confCanvas.getContext('2d');
    let confPieces = [];
    function launchConfetti(count = 75) {
      confCanvas.width = window.innerWidth; confCanvas.height = window.innerHeight;
      const colors = ['#38bdf8', '#f472b6', '#fbbf24', '#34d399', '#a78bfa'];
      for (let i = 0; i < count; i++) {
        confPieces.push({
          x: Math.random() * confCanvas.width, y: -15 - Math.random() * 80,
          vx: (Math.random() - 0.5) * 4, vy: 2.5 + Math.random() * 4.5,
          w: 7 + Math.random() * 5, h: 5 + Math.random() * 4,
          rot: Math.random() * Math.PI * 2, vrot: (Math.random() - 0.5) * 0.2,
          color: colors[i % colors.length]
        });
      }
    }
    function loopConfetti() {
      if (confPieces.length > 0) {
        confCtx.clearRect(0, 0, confCanvas.width, confCanvas.height);
        for (let i = confPieces.length - 1; i >= 0; i--) {
          const c = confPieces[i]; c.x += c.vx; c.y += c.vy; c.rot += c.vrot;
          if (c.y > confCanvas.height + 20) { confPieces.splice(i, 1); continue; }
          confCtx.save(); confCtx.translate(c.x, c.y); confCtx.rotate(c.rot);
          confCtx.fillStyle = c.color; confCtx.fillRect(-c.w/2, -c.h/2, c.w, c.h); confCtx.restore();
        }
      }
      requestAnimationFrame(loopConfetti);
    }

    // ========= 🗺️ 日本一周マップ描画 =========
    function getReachableCodes() {
      const set = new Set();
      state.visited.forEach(vc => {
        const p = getPref(vc);
        p.neighbors.forEach(nc => { if (!state.visited.includes(nc)) set.add(nc); });
      });
      return set;
    }

    function regionBgGrad(region) {
      const m = {
        '北海道': 'linear-gradient(135deg,#dbeafe,#ede9fe)',
        '東北': 'linear-gradient(135deg,#d1fae5,#e0f2fe)',
        '関東': 'linear-gradient(135deg,#fce7f3,#e0f2fe)',
        '中部': 'linear-gradient(135deg,#fef3c7,#d1fae5)',
        '近畿': 'linear-gradient(135deg,#ede9fe,#fce7f3)',
        '中国': 'linear-gradient(135deg,#ffedd5,#e0f2fe)',
        '四国': 'linear-gradient(135deg,#ccfbf1,#fef3c7)',
        '九州': 'linear-gradient(135deg,#ffe4e6,#fef9c3)'
      };
      return m[region] || 'linear-gradient(135deg,#e0f2fe,#fce7f3)';
    }

    function renderPostcardVisual(containerEl, pref, isVisited) {
      const artPath = DB.prefImages[String(pref.code)];
      containerEl.style.background = regionBgGrad(pref.region);
      if (artPath && isVisited) {
        containerEl.innerHTML = `
          <span class="pref-tag-overlay">${pref.region}地方・${pref.name}</span>
