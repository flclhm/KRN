    function startWeakRevengeStage() {
      if (!state.weakness.length) { showToast('弱点はないよ！すごい✨'); return; }
      sfxTap(); switchTab('game');
      const wqs = state.weakness.map(id => DB.gameQuestions.find(q => q.id === id)).filter(Boolean);
      playMode = 'revenge'; playPool = wqs; playQueue = shuffle(wqs);
      combo = 0; maxCombo = 0; ansCnt = 0; corCnt = 0; missCnt = 0; locked = false;
